# Source du catalogue : "mock" (données locales de démonstration) ou "shopify"
COMMERCE_PROVIDER=mock

# --- Shopify Storefront API (requis si COMMERCE_PROVIDER=shopify) ---
# Domaine de la boutique, sans https://
SHOPIFY_STORE_DOMAIN=zv0abg-pj.myshopify.com
# Jeton d'accès public Storefront (canal de vente Headless > vitrine > Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Version de l'API Storefront
SHOPIFY_API_VERSION=2026-07
# Produit technique des créations de l'atelier (une variante par palier de 5 €)
SHOPIFY_ATELIER_HANDLE=creation-atelier

# URL publique du site (SEO, partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
